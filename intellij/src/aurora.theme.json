{
  "name": "Aurora",
  "dark": true,
  "author": "xKrisSx",
  "editorScheme": "/AuroraScheme.xml",
  "background": { "image": "aurora-bg.jpg", "transparency": 14, "fill": "scale", "anchor": "center" },
  "emptyFrameBackground": { "image": "aurora-bg.jpg", "transparency": 70, "fill": "scale", "anchor": "center" },
  "colors": {
    "bg": "#0b0c10",
    "bgAlt": "#101217",
    "bgHover": "#161920",
    "border": "#1c1f27",
    "fg": "#d6dae2",
    "fgMuted": "#8f9bb8",
    "accent": "#3ee0a8",
    "accentDim": "#1b3a33",
    "violet": "#a98bff"
  },
  "ui": {
    "*": {
      "background": "bg",
      "foreground": "fg",
      "infoForeground": "fgMuted",
      "disabledForeground": "#5b6272",
      "selectionBackground": "accentDim",
      "selectionForeground": "#eceef2",
      "selectionInactiveBackground": "#15181f",
      "selectionBackgroundInactive": "#15181f",
      "hoverBackground": "bgHover",
      "borderColor": "border",
      "separatorColor": "border",
      "focusColor": "accent",
      "focusedBorderColor": "accent",
      "inactiveBackground": "bg",
      "lightSelectionBackground": "#13161c",
      "acceleratorForeground": "fgMuted"
    },
    "MainToolbar.background": "#07080b",
    "MainWindow.Tab.selectedBackground": "bgAlt",
    "StatusBar.background": "#07080b",
    "ToolWindow.background": "bg",
    "ToolWindow.Header.background": "bgAlt",
    "ToolWindow.Header.inactiveBackground": "bg",
    "ToolWindow.HeaderTab.selectedInactiveBackground": "#15181f",
    "EditorTabs.background": "bg",
    "EditorTabs.underlinedTabBackground": "bgAlt",
    "EditorTabs.underlineColor": "accent",
    "EditorTabs.inactiveUnderlineColor": "#2a6b55",
    "DefaultTabs.underlineColor": "accent",
    "DefaultTabs.inactiveUnderlineColor": "#2a6b55",
    "Button.default.startBackground": "#2bb589",
    "Button.default.endBackground": "#2bb589",
    "Button.default.foreground": "#04110c",
    "Button.default.focusedBorderColor": "accent",
    "Link.activeForeground": "accent",
    "Link.hoverForeground": "#7ff0c6",
    "ProgressBar.progressColor": "accent",
    "ProgressBar.indeterminateStartColor": "accent",
    "ProgressBar.indeterminateEndColor": "violet",
    "Tree.selectionBackground": "accentDim",
    "List.selectionBackground": "accentDim",
    "Table.selectionBackground": "accentDim",
    "Popup.background": "bgAlt",
    "Popup.borderColor": "border",
    "ScrollBar.thumbColor": "#2a2f3a80",
    "ScrollBar.hoverThumbColor": "#3a4150a0",
    "Component.focusColor": "accent",
    "CheckBox.Checked.background": "accent"
  }
}
